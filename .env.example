# Telegram
BOT_TOKEN=
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# LLM (OpenRouter, OpenAI-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
