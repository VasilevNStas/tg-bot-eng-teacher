# Telegram
BOT_TOKEN=
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# Admin bot (separate token and process; optional `admin` compose profile)
ADMIN_BOT_TOKEN=
ADMIN_IDS=
ADMIN_ALERT_CHAT_ID=

# Containment and flood control
BLOCK_MODE=silent
MUTE_MODE=neutral
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MESSAGES_PER_MIN=20
RATE_LIMIT_COMMANDS_PER_MIN=10

# LLM (OpenRouter, OpenAI-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_MODEL_FALLBACK=
LLM_MODEL_ROLEPLAY=
LLM_MODEL_SUMMARY=
LLM_MODEL_JUDGE=
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0
LLM_RETRY_MAX_BACKOFF_SECONDS=8
LLM_CIRCUIT_BREAKER_FAILURES=5
LLM_CIRCUIT_BREAKER_SECONDS=60
LLM_REPAIR_ATTEMPTS=1
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=800
LLM_TEMPERATURE_CHAT=0.7
LLM_TEMPERATURE_CORRECTION=0.3
LLM_TEMPERATURE_ROLEPLAY=0.8
LLM_TEMPERATURE_SUMMARY=0.2
LLM_TEMPERATURE_JUDGE=0.0
LLM_MAX_TOKENS_CHAT=600
LLM_MAX_TOKENS_CORRECTION=800
LLM_MAX_TOKENS_ROLEPLAY=500
LLM_MAX_TOKENS_SUMMARY=300
LLM_MAX_TOKENS_JUDGE=200

# Storage
DB_PATH=./data/bot.db
# Container user (default 10001). On VDS set to the deploy user's UID/GID.
# BOT_UID=10001
# BOT_GID=10001

# Prompts
PROMPTS_DIR=./prompts
PROMPT_HISTORY_WINDOW=12
SUMMARY_BATCH_MESSAGES=12
SUMMARY_MAX_BATCH_MESSAGES=50
SUMMARY_MESSAGE_MAX_CHARS=800
SUMMARY_MAX_CHARS=2000
MAX_CONVERSATION_MESSAGES=200
CONVERSATION_IDLE_MINUTES=30
DRILL_SESSION_SIZE=5
TRANSLATION_SESSION_SIZE=3
WORDS_CARD_SIZE=10

# Limits
DAILY_TOKEN_BUDGET=50000
GLOBAL_MONTHLY_BUDGET_USD=2.00
BUDGET_ALERT_POLL_SECONDS=300
MAX_USER_MESSAGE_CHARS=2000
TYPING_INDICATOR_ENABLED=true
USER_LOCK_TIMEOUT_SECONDS=90
PROCESSED_UPDATES_RETENTION_DAYS=7
HISTORY_RETENTION_DAYS=90
REMINDER_POLL_SECONDS=60
REMINDER_BATCH_SIZE=100

# Observability
LOG_LEVEL=INFO
LOG_JSON=false
