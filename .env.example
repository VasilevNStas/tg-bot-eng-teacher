# Telegram
BOT_TOKEN=
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# LLM (OpenRouter, OpenAI-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_MODEL_FALLBACK=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=800

# Storage
DB_PATH=./data/bot.db

# Prompts
PROMPTS_DIR=./prompts
PROMPT_HISTORY_WINDOW=12
CONVERSATION_IDLE_MINUTES=30
DRILL_SESSION_SIZE=5

# Limits
DAILY_TOKEN_BUDGET=50000
USER_LOCK_TIMEOUT_SECONDS=90
PROCESSED_UPDATES_RETENTION_DAYS=7
REMINDER_POLL_SECONDS=60
REMINDER_BATCH_SIZE=100

# Observability
LOG_LEVEL=INFO
LOG_JSON=false
